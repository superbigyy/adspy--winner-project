# Required. This app reads the Apify token from here ONLY — there is no
# per-user token field in the UI anymore. One operator (you) runs the app,
# and every search is billed to this account.
# PowerShell (current session):
#   $env:APIFY_TOKEN="apify_api_..."
# Or permanently:
#   setx APIFY_TOKEN "apify_api_..."
APIFY_TOKEN=
